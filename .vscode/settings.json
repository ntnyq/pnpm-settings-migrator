{
  "oxc.enable": true,
  "eslint.enable": false,
  "prettier.enable": false,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.format.oxc": "explicit"
  },
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "node_modules/typescript",
  "eslint.validate": [
    "vue",
    "yaml",
    "toml",
    "json",
    "jsonc",
    "json5",
    "markdown",
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact"
  ],
  "cSpell.words": [
    "bumpp",
    "cafile",
    "changelogithub",
    "codecov",
    "Cves",
    "dedupe",
    "defu",
    "esbuild",
    "GHSA",
    "Ghsas",
    "lcov",
    "libc",
    "napi",
    "noproxy",
    "Npmrcs",
    "oxfmt",
    "oxlint",
    "packument",
    "pathe",
    "pnpm",
    "pnpmfile",
    "pnpr",
    "pypi",
    "tsdown",
    "tsgo",
    "undelegated",
    "unmigrated",
    "unrs",
    "vite",
    "vitepress",
    "vitest"
  ],
  "cSpell.allowCompoundWords": true
}
